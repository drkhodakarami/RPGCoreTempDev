        </ui:VisualElement>
        <ui:VisualElement name="RightPanel" style="flex-grow: 1; margin-right: 4px;">
            <ui:Instance template="SettingsPanelMenuToolbar" name="SettingsPanelMenuToolbar" />
            <ui:ScrollView>
                <ui:Instance template="BaseInfoFoldout" name="BaseInfoFoldout" />
